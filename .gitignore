.env

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
venv/
.venv/

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store

# Salvaged copy of the corrupted git directory
.git-corrupted-backup/

# Reports (generated locally / downloaded from Actions)
reports/*
!reports/microsite_snapshot.json
!reports/portfolio.meta.json
!reports/orders_latest.html
!reports/orders_latest.csv
!reports/orders_latest.md

# Local price/data caches (incl. sync checkpoint state)
.cache/

# Price lake
# Cold years are committed Parquet; the hot year is a committed CSV that git can
# delta cheaply. Parquet is ignored by default and un-ignored per closed year --
# gitignore cannot know the current year, so this list is maintained by hand at
# the January rollover. See data/prices/_schema.md.
# 2005-2022 were added by scripts/backfill_history.py; extend this list whenever
# that script reports a new year, or the data stays uncommitted.
data/prices/daily/*.parquet
!data/prices/daily/2005.parquet
!data/prices/daily/2006.parquet
!data/prices/daily/2007.parquet
!data/prices/daily/2008.parquet
!data/prices/daily/2009.parquet
!data/prices/daily/2010.parquet
!data/prices/daily/2011.parquet
!data/prices/daily/2012.parquet
!data/prices/daily/2013.parquet
!data/prices/daily/2014.parquet
!data/prices/daily/2015.parquet
!data/prices/daily/2016.parquet
!data/prices/daily/2017.parquet
!data/prices/daily/2018.parquet
!data/prices/daily/2019.parquet
!data/prices/daily/2020.parquet
!data/prices/daily/2021.parquet
!data/prices/daily/2022.parquet
!data/prices/daily/2023.parquet
!data/prices/daily/2024.parquet
!data/prices/daily/2025.parquet

# Site (Vite)
site/node_modules/
site/dist/

# Manus microsite
microsite/node_modules/
microsite/dist/
microsite/.manus-logs/

# Backtest run artifacts (large, machine-specific)
runs/

# CCE (code-context-engine)
# CCE local cache (per-machine, not for version control)
.cce/
# Claude Code local settings written by cce init
.claude/settings.local.json
# .mcp.json contains absolute paths regenerated by `cce init`
.mcp.json
# Same for the VS Code copy
.vscode/mcp.json
